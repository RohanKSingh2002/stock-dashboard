{
  "name": "Market Desk",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bullseye",
  "features": { "ghcr.io/devcontainers/features/node:1": { "version": "22" } },
  "customizations": {
    "codespaces": { "openFiles": ["README.md", "backend/app.py", "frontend/src/App.tsx"] },
    "vscode": { "extensions": ["ms-python.python", "ms-python.vscode-pylance"] }
  },
  "updateContentCommand": "pip3 install --user -r backend/requirements.txt && cd frontend && npm install && npm run build",
  "postAttachCommand": { "server": "cd backend && python3 -m uvicorn app:app --host 0.0.0.0 --port 8000" },
  "portsAttributes": { "8000": { "label": "Market Desk", "onAutoForward": "openPreview" } },
  "forwardPorts": [8000]
}
